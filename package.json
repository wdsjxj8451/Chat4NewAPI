{
  "name": "chat4newapi",
  "version": "0.1.0",
  "description": "Chat4NewAPI is a self-hosted chat workspace for Anthropic Messages, OpenAI Chat Completions, and OpenAI Responses gateways.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.mjs\" \"rspack serve -c rspack.config.ts\"",
    "dev:web": "rspack serve -c rspack.config.ts",
    "dev:server": "node --watch server/index.mjs",
    "build": "rspack build -c rspack.config.ts",
    "start": "node server/index.mjs",
    "test": "node --test server/index.test.mjs",
    "check:server": "node --check server/index.mjs && node --check server/gatewayAdapters.mjs && node --check server/backup.mjs",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7",
    "better-sqlite3": "^11.10.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "concurrently": "^9.2.1",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  }
}
